+static int apply_quest_asymmetric_projection(uint8_t *localView, int pass) {
+    if (!localView || (pass != 1 && pass != 2)) return 0;
+
+    const float zNear = *(const float*)(localView + OFF_ZNEAR);
+    const float zFar  = *(const float*)(localView + OFF_ZFAR);
+    if (!isfinite(zNear) || !isfinite(zFar) ||
+        !(zNear > 0.001f) || !(zFar > zNear + 1.0f)) {
+        return 0;
+    }
+
+    float matrix[16];
+    memset(matrix, 0, sizeof(matrix));
+
+    matrix[0]  = QUEST_M00;                         /* M00 */
+    matrix[2]  = (pass == 1) ? -QUEST_M02_ABS
+                             : +QUEST_M02_ABS;      /* M02 */
+    matrix[5]  = QUEST_M11;                         /* M11 */
+    matrix[6]  = QUEST_M12;                         /* M12 */
+    matrix[10] = zFar / (zNear - zFar);             /* M22 */
+    matrix[11] = (zNear * zFar) / (zNear - zFar);   /* M23 */
+    matrix[14] = -1.0f;                             /* M32 */
+    matrix[15] = 0.0f;                              /* M33 */
+
+    for (int i = 0; i < 16; ++i) {
+        if (!isfinite(matrix[i])) return 0;
+    }
+
+    /* Commit the complete matrix first. Enable custom projection last. */
+    memcpy(localView + OFF_CUSTOM_PROJ_MATRIX, matrix, sizeof(matrix));
+    localView[OFF_CUSTOM_PROJ_BOOL] = 1;
+    return 1;
+}
