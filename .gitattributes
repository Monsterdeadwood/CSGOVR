# Keep forensic/source text byte-stable across Windows/Linux checkouts.
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.patch text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Original packaging scripts may intentionally have other historical newline/BOM
# conventions and are not committed as byte-identical source unless explicitly
# documented beside their package manifest.
